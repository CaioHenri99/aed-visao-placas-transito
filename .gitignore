# ---------------------------------------------------------------- dados
# Imagens não são versionadas no Git: o notebook as baixa a partir do
# Roboflow e o inventário em outputs/inventario_dataset.csv registra o que
# foi usado, garantindo a reprodutibilidade sem inflar o repositório.
data/*
!data/.gitkeep

# --------------------------------------------------------------- saídas
# As figuras e tabelas geradas SÃO versionadas (são a evidência visual do
# checkpoint). Apenas o pacote compactado fica de fora.
outputs_checkpoint1.zip

# -------------------------------------------------------------- modelos
# Só o peso do modelo escolhido na N2 é versionado (modelos/modelo_n2.pt). Pesos
# iniciais baixados pelo Ultralytics e pastas de treino ficam fora.
*.pt
!modelos/*.pt
runs/

# Pasta padrão das imagens anotadas e JSON do inferir.py, e a pasta em que os
# artefatos do treino chegam do Drive antes de irem para outputs/ e modelos/.
saida_inferencia/
/treino/

# ------------------------------------------------------------- ambiente
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.python-version

# ---------------------------------------------------------------- IDEs
.vscode/
.idea/
*.swp

# ------------------------------------------------------------- sistema
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------- segredos
# A chave da API do Roboflow é pedida em tempo de execução e nunca gravada.
.env
*.key

# Material de aula do professor: fica local, nao e redistribuido no repositorio.
docs/referencias/Apostila*.pdf

# Gerador local do PDF do relatorio: ferramenta de quem edita, fora do repositorio.
docs/gerar_relatorio.py
